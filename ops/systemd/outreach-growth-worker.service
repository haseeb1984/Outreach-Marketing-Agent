[Unit]
Description=Outreach Marketing Agent durable website-growth worker
Documentation=https://github.com/haseeb1984/Outreach-Marketing-Agent/blob/main/docs/WORKER_OPERATIONS.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=oma-worker
Group=oma-worker
WorkingDirectory=/opt/outreach-marketing-agent/backend
EnvironmentFile=/etc/outreach-marketing-agent/worker.env
ExecStart=/opt/outreach-marketing-agent/venv/bin/python scripts/run_workspace_growth_worker.py --poll-seconds 3
Restart=on-failure
RestartSec=5
TimeoutStopSec=270
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/outreach-marketing-agent
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
