# Copy to backend/.env for local development. Never put real secrets in this file in Git.
# Production secrets belong in the hosting platform's encrypted environment settings.
ENVIRONMENT=development
APP_NAME=Outreach Marketing Agent API
API_PREFIX=/api/v1
PUBLIC_BASE_URL=https://your-real-https-domain.example

# Required before enabling database-backed features. Use a least-privilege PostgreSQL role.
DATABASE_URL=

# Generate a unique high-entropy secret for each environment; do not reuse this placeholder.
SECRET_KEY=

# SMTP credentials are optional until email verification is enabled.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Outreach Marketing Agent
SMTP_STARTTLS=true
