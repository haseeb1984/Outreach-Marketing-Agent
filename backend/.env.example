# Copy to backend/.env for local development. Never put real secrets in this file in Git.
# Production secrets belong in the hosting platform's encrypted environment settings.
ENVIRONMENT=development
APP_NAME=Outreach Marketing Agent API
API_PREFIX=/api/v1
PUBLIC_BASE_URL=https://your-real-https-domain.example
# Exact HTTPS origin(s) of the Hostinger frontend, comma-separated; no paths or wildcards.
FRONTEND_ORIGINS=https://app.yourdomain.example
# Canonical Hostinger frontend origin used in workspace invitation links.
FRONTEND_PUBLIC_URL=https://app.yourdomain.example

# Optional public-web prospect research provider; key is server-only.
BRAVE_SEARCH_API_KEY=

# Optional OpenAI-compatible AI outreach generation. Drafts still require human approval.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# URL-safe base64-encoded 32-byte key. Keep stable per environment and never log or commit the real key.
# Generate with: python -c "import base64,secrets;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
PROVIDER_CREDENTIAL_ENCRYPTION_KEY=

# Required before enabling database-backed features. Use a least-privilege PostgreSQL role.
DATABASE_URL=

# Generate a unique high-entropy secret for each environment; do not reuse this placeholder.
SECRET_KEY=

# Platform-owner allowlist. Comma-separated exact email addresses; keep this configurable per environment.
PLATFORM_ADMIN_EMAILS=outreach@juncsys.com

# Required for public registration and password-reset delivery; use real secrets only in ignored .env or hosting secret settings.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Outreach Marketing Agent
SMTP_STARTTLS=true

# Paddle Billing. Start with sandbox credentials and sandbox price IDs.
# Configure the matching Paddle notification destination secret for /api/v1/billing/paddle/webhook.
PADDLE_ENVIRONMENT=sandbox
# Must remain false until merchant eligibility, policies, sandbox acceptance and production checks are approved.
PADDLE_LIVE_CHECKOUT_ENABLED=false
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
# JSON object keyed by internal plan slug; each plan maps to one real Paddle recurring price ID.
# Entitlements are server-controlled and are never accepted from browser input.
# Outreach Marketing Agent Sandbox catalog (actual Price IDs supplied by the owner).
# Suggested initial sandbox quotas below: Starter WhatsApp is disabled. Review limits before launch.
# Do not use these sandbox IDs in production.
# Quota policy values are server-side; monthly_limit: 0 denies usage when enabled, null means unlimited.
PADDLE_PLANS_JSON={"starter":{"price_id":"pri_01m61xstp0gy07re6ynykhdcgb","name":"Starter","description":"Essential outreach and campaign management tools.","display_price":"$29","currency":"USD","billing_interval":"month","entitlements":{"ai_draft_generations":{"enabled":true,"monthly_limit":250},"email_sends":{"enabled":true,"monthly_limit":1000},"website_audits":{"enabled":true,"monthly_limit":25},"whatsapp_sends":{"enabled":false,"monthly_limit":0},"prospect_research":{"enabled":true,"monthly_limit":100}}},"growth":{"price_id":"pri_01m61y1n4enqgf0qbtbm67tkx2","name":"Growth","description":"Advanced outreach automation and campaign growth tools.","display_price":"$79","currency":"USD","billing_interval":"month","entitlements":{"ai_draft_generations":{"enabled":true,"monthly_limit":1000},"email_sends":{"enabled":true,"monthly_limit":5000},"website_audits":{"enabled":true,"monthly_limit":100},"whatsapp_sends":{"enabled":true,"monthly_limit":1000},"prospect_research":{"enabled":true,"monthly_limit":500}}},"agency":{"price_id":"pri_01m61y66jhcs5qf0cf9n20a3xf","name":"Agency","description":"Higher-capacity outreach and multi-client campaign management.","display_price":"$199","currency":"USD","billing_interval":"month","entitlements":{"ai_draft_generations":{"enabled":true,"monthly_limit":5000},"email_sends":{"enabled":true,"monthly_limit":25000},"website_audits":{"enabled":true,"monthly_limit":500},"whatsapp_sends":{"enabled":true,"monthly_limit":10000},"prospect_research":{"enabled":true,"monthly_limit":2000}}}}

# Required for outreach email: signs recipient-specific RFC 8058 unsubscribe links and normalized provider callbacks.
# Provider callbacks must first be verified with the ESP's native signature in your provider relay.
# Also used by the normalized inbound-reply webhook. Generate a unique random secret (32+ bytes).
# Protects scheduled email and WhatsApp worker endpoints; use a unique random value of at least 32 bytes.
CRON_SECRET=
OUTREACH_WEBHOOK_SECRET=

# Meta WhatsApp Cloud API (staging secrets only; never commit real values)
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Default Meta asset IDs are optional diagnostics only; workspace connections store IDs per tenant.
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_WABA_ID=
# Meta webhook verify token: generate a unique random value of at least 32 bytes.
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Pin a currently supported Graph API version, e.g. vXX.0, after checking Meta documentation.
META_GRAPH_API_VERSION=
# The Meta App Secret above verifies X-Hub-Signature-256 against the exact raw request body.
# Configure the WhatsApp webhook callback URL and subscribe to messages and message status fields in Meta.
# Account verification also subscribes the app to each connected WABA using the account token.
# Outbound dispatch remains fail-closed until explicitly enabled after Meta review and live acceptance.
WHATSAPP_DISPATCH_ENABLED=false
