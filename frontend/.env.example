# Server-side proxy target. This is an origin, not a credential.
BACKEND_API_ORIGIN=https://outreach-marketing-agent.vercel.app

# Canonical public frontend origin for robots.txt and sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://app.yourdomain.example

# Optional public support address shown on the Contact page (not a secret).
NEXT_PUBLIC_SUPPORT_EMAIL=
