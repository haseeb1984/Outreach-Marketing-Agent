# Copy to backend/.env for local development. Never put real secrets in this file in Git.
# Production secrets belong in the hosting platform's encrypted environment settings.
ENVIRONMENT=development
APP_NAME=Outreach Marketing Agent API
API_PREFIX=/api/v1
PUBLIC_BASE_URL=https://your-real-https-domain.example

# Production website fetching must use an operator-managed proxy that blocks private/metadata IPs at connection time.
# Leave blank for local development; production fetching fails closed unless configured.
TRUSTED_EGRESS_PROXY_URL=

# Required before enabling database-backed features. Use a least-privilege PostgreSQL role.
DATABASE_URL=

# Generate a unique high-entropy secret for each environment; do not reuse this placeholder.
SECRET_KEY=

# Required for public registration and password-reset delivery; use real secrets only in ignored .env or hosting secret settings.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Outreach Marketing Agent
SMTP_STARTTLS=true

# Optional provider-neutral inbound reply webhook; configure a unique random secret (32+ bytes) in encrypted host settings.
OUTREACH_WEBHOOK_SECRET=
