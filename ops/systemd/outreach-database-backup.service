[Unit]
Description=Outreach Marketing Agent PostgreSQL backup
Documentation=https://github.com/haseeb1984/Outreach-Marketing-Agent/blob/main/docs/PRODUCTION_OPERATIONS_AND_LAUNCH.md
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/mnt/oma-backups

[Service]
Type=oneshot
User=oma-backup
Group=oma-backup
WorkingDirectory=/opt/outreach-marketing-agent/backend
EnvironmentFile=/etc/outreach-marketing-agent/backup.env
ExecStartPre=/usr/bin/mountpoint -q /mnt/oma-backups
ExecStart=/opt/outreach-marketing-agent/venv/bin/python scripts/database_backup.py backup
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/mnt/oma-backups
UMask=0077
StandardOutput=journal
StandardError=journal
