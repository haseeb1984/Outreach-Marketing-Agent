# Repository metadata and documentation are not runtime assets
.git/
.github/
docs/
README.md

# Frontend/build artefacts if present in the repository
node_modules/
.next/
dist/
build/
coverage/

# Python test and local development artefacts
**/tests/
**/test_*.py
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.venv/
**/venv/

# Never package local environment files or examples
**/.env
**/.env.*

.DS_Store
.vscode/
.idea/
