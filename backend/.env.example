# Copy to backend/.env for local development. Never put real secrets in this file in Git.
# Production secrets belong in the hosting platform's encrypted environment settings.
ENVIRONMENT=development
APP_NAME=Outreach Marketing Agent API
API_PREFIX=/api/v1
PUBLIC_BASE_URL=https://your-real-https-domain.example
# Exact HTTPS origin(s) of the Hostinger frontend, comma-separated; no paths or wildcards.
FRONTEND_ORIGINS=https://app.yourdomain.example
# Canonical Hostinger frontend origin used in workspace invitation links.
FRONTEND_PUBLIC_URL=https://app.yourdomain.example

# Optional public-web prospect research provider; key is server-only.
BRAVE_SEARCH_API_KEY=

# URL-safe base64-encoded 32-byte key. Keep stable per environment and never log or commit the real key.
# Generate with: python -c "import base64,secrets;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
PROVIDER_CREDENTIAL_ENCRYPTION_KEY=

# Production website fetching must use an operator-managed proxy that blocks private/metadata IPs at connection time.
# Leave blank for local development; production fetching fails closed unless configured.
TRUSTED_EGRESS_PROXY_URL=

# Required before enabling database-backed features. Use a least-privilege PostgreSQL role.
DATABASE_URL=

# Generate a unique high-entropy secret for each environment; do not reuse this placeholder.
SECRET_KEY=

# Required for public registration and password-reset delivery; use real secrets only in ignored .env or hosting secret settings.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Outreach Marketing Agent
SMTP_STARTTLS=true

# Paddle Billing. Start with sandbox credentials and sandbox price IDs.
# Configure the matching Paddle notification destination secret for /api/v1/billing/paddle/webhook.
PADDLE_ENVIRONMENT=sandbox
# Must remain false until merchant eligibility, policies, sandbox acceptance and production checks are approved.
PADDLE_LIVE_CHECKOUT_ENABLED=false
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
# JSON keyed by plan slug. Each price_id must be a real Paddle recurring price ID.
# Example shape only; replace with actual Paddle price IDs and approved entitlements:
# PADDLE_PLANS_JSON={"starter_monthly":{"price_id":"pri_replace_me","name":"Starter","display_price":"replace with approved price","currency":"USD","billing_interval":"month","entitlements":{"ai_draft_generations":{"enabled":true,"monthly_limit":100},"email_sends":{"enabled":true,"monthly_limit":100},"prospect_research":{"enabled":true,"monthly_limit":50},"website_audits":{"enabled":true,"monthly_limit":10}}}}
PADDLE_PLANS_JSON=

# Optional provider-neutral inbound reply webhook; configure a unique random secret (32+ bytes) in encrypted host settings.
OUTREACH_WEBHOOK_SECRET=

# Meta WhatsApp Cloud API (staging secrets only; never commit real values)
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Default Meta asset IDs are optional diagnostics only; workspace connections store IDs per tenant.
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_WABA_ID=
# Meta webhook verify token: generate a unique random value of at least 32 bytes.
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# The Meta App Secret above is used to verify X-Hub-Signature-256 against the exact raw request body.
# Subscribe the app to the WhatsApp Business Account webhook fields in Meta's dashboard.
# The receiver persists verified events; tenant mapping, consent checks and sending remain disabled until implemented.
